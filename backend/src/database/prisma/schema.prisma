generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role
  status        UserStatus     @default(ACTIVE)
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

// Only a hash of the refresh token is stored, so a DB leak cannot be used to log in.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Pilot city is Jamshoro; adding Hyderabad later is just new rows.
model City {
  id    String @id @default(uuid())
  name  String @unique
  areas Area[]

  @@map("cities")
}

model Area {
  id     String @id @default(uuid())
  name   String
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, name])
  @@map("areas")
}

model Subject {
  id   String @id @default(uuid())
  name String @unique

  @@map("subjects")
}
