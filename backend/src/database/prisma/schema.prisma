generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TeachingMode {
  HOME
  ONLINE
  BOTH
}

// Set by admins in step 1.4; only VERIFIED tutors get the verified badge.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role
  status        UserStatus      @default(ACTIVE)
  emailVerified Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  tutorProfile  TutorProfile?
  shortlist     ShortlistItem[]
  reviews       Review[]
  notifications Notification[]
  requests      TutorRequest[]
  enrollments   Enrollment[]

  @@index([role])
  @@map("users")
}

enum DocumentType {
  CNIC_FRONT
  CNIC_BACK
  DEGREE
  OTHER
}

// The file itself lives on disk (UPLOAD_DIR) under a random name; the DB keeps the metadata.
model VerificationDocument {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  type           DocumentType
  storedName     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime     @default(now())

  @@index([tutorProfileId])
  @@map("verification_documents")
}

// One profile per tutor. Subjects and areas are many-to-many (Prisma creates the join tables).
model TutorProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline           String
  bio                String
  qualification      String
  experienceYears    Int                    @default(0)
  hourlyRate         Int // PKR per hour
  teachingMode       TeachingMode
  isPublished        Boolean                @default(false)
  verificationStatus VerificationStatus     @default(UNVERIFIED)
  verificationNote   String? // admin's reason when REJECTED
  reviewedAt         DateTime?
  documents          VerificationDocument[]
  shortlistedBy      ShortlistItem[]
  requests           TutorRequest[]
  reviews            Review[]
  courses            Course[]
  // Denormalized from visible reviews so search can sort/filter without joins.
  ratingAvg          Float                  @default(0)
  ratingCount        Int                    @default(0)
  subjects           Subject[]
  areas              Area[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([isPublished, verificationStatus])
  @@index([hourlyRate])
  @@index([ratingAvg])
  @@map("tutor_profiles")
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  REVIEW_RECEIVED
  COURSE_ENROLLED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

// Saved so users see alerts they missed while offline; Socket.IO only delivers the live ones.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// One review per author per tutor. Only people with an ACCEPTED request may write one.
model Review {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  status         ReviewStatus @default(VISIBLE)
  moderationNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([authorId, tutorProfileId])
  @@index([tutorProfileId, status, createdAt])
  @@map("reviews")
}

// Only a hash of the refresh token is stored, so a DB leak cannot be used to log in.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Pilot city is Jamshoro; adding Hyderabad later is just new rows.
model City {
  id    String @id @default(uuid())
  name  String @unique
  areas Area[]

  @@map("cities")
}

model Area {
  id       String         @id @default(uuid())
  name     String
  cityId   String
  city     City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tutors   TutorProfile[]
  requests TutorRequest[]

  @@unique([cityId, name])
  @@map("areas")
}

model Subject {
  id       String         @id @default(uuid())
  name     String         @unique
  tutors   TutorProfile[]
  requests TutorRequest[]
  courses  Course[]

  @@map("subjects")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

// A structured course made by a tutor: ordered lessons students can enroll in and track.
model Course {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  title          String
  description    String
  level          CourseLevel  @default(BEGINNER)
  price          Int          @default(0) // PKR, 0 = free. Online payment is out of scope for now.
  status         CourseStatus @default(DRAFT)
  lessons        Lesson[]
  enrollments    Enrollment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, subjectId])
  @@index([tutorProfileId])
  @@map("courses")
}

model Lesson {
  id          String           @id @default(uuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  content     String // lesson text; only enrolled students and the owner can read it
  videoUrl    String?
  durationMin Int              @default(10)
  position    Int
  progress    LessonProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([courseId, position])
  @@map("lessons")
}

model Enrollment {
  id        String           @id @default(uuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  createdAt DateTime         @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("enrollments")
}

// One row per completed lesson; progress % = completed rows / lessons in the course.
model LessonProgress {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// A student's saved tutors. One row per (student, tutor).
model ShortlistItem {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([studentId, tutorProfileId])
  @@index([studentId, createdAt])
  @@map("shortlist_items")
}

// A student asks a tutor for lessons. Contact details are shared only once ACCEPTED.
model TutorRequest {
  id             String        @id @default(uuid())
  studentId      String
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile   TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id])
  areaId         String?
  area           Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  mode           TeachingMode // HOME or ONLINE (never BOTH: the student picks one)
  budgetPerHour  Int?
  message        String
  status         RequestStatus @default(PENDING)
  responseNote   String?
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId, status])
  @@index([tutorProfileId, status])
  @@map("tutor_requests")
}
