generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TeachingMode {
  HOME
  ONLINE
  BOTH
}

// Set by admins in step 1.4; only VERIFIED tutors get the verified badge.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role
  status        UserStatus      @default(ACTIVE)
  emailVerified Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  tutorProfile  TutorProfile?
  shortlist     ShortlistItem[]
  requests      TutorRequest[]

  @@index([role])
  @@map("users")
}

enum DocumentType {
  CNIC_FRONT
  CNIC_BACK
  DEGREE
  OTHER
}

// The file itself lives on disk (UPLOAD_DIR) under a random name; the DB keeps the metadata.
model VerificationDocument {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  type           DocumentType
  storedName     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime     @default(now())

  @@index([tutorProfileId])
  @@map("verification_documents")
}

// One profile per tutor. Subjects and areas are many-to-many (Prisma creates the join tables).
model TutorProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline           String
  bio                String
  qualification      String
  experienceYears    Int                    @default(0)
  hourlyRate         Int // PKR per hour
  teachingMode       TeachingMode
  isPublished        Boolean                @default(false)
  verificationStatus VerificationStatus     @default(UNVERIFIED)
  verificationNote   String? // admin's reason when REJECTED
  reviewedAt         DateTime?
  documents          VerificationDocument[]
  shortlistedBy      ShortlistItem[]
  requests           TutorRequest[]
  subjects           Subject[]
  areas              Area[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([isPublished, verificationStatus])
  @@index([hourlyRate])
  @@map("tutor_profiles")
}

// Only a hash of the refresh token is stored, so a DB leak cannot be used to log in.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Pilot city is Jamshoro; adding Hyderabad later is just new rows.
model City {
  id    String @id @default(uuid())
  name  String @unique
  areas Area[]

  @@map("cities")
}

model Area {
  id       String         @id @default(uuid())
  name     String
  cityId   String
  city     City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tutors   TutorProfile[]
  requests TutorRequest[]

  @@unique([cityId, name])
  @@map("areas")
}

model Subject {
  id       String         @id @default(uuid())
  name     String         @unique
  tutors   TutorProfile[]
  requests TutorRequest[]

  @@map("subjects")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// A student's saved tutors. One row per (student, tutor).
model ShortlistItem {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([studentId, tutorProfileId])
  @@index([studentId, createdAt])
  @@map("shortlist_items")
}

// A student asks a tutor for lessons. Contact details are shared only once ACCEPTED.
model TutorRequest {
  id             String        @id @default(uuid())
  studentId      String
  student        User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorProfileId String
  tutorProfile   TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id])
  areaId         String?
  area           Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  mode           TeachingMode // HOME or ONLINE (never BOTH: the student picks one)
  budgetPerHour  Int?
  message        String
  status         RequestStatus @default(PENDING)
  responseNote   String?
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId, status])
  @@index([tutorProfileId, status])
  @@map("tutor_requests")
}
