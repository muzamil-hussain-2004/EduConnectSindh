# Copy this file to .env and change the values. NEVER commit .env.
NODE_ENV=development
PORT=5000

# PostgreSQL (docker-compose uses host port 5433 to avoid clashing with a local install)
POSTGRES_USER=educonnect
POSTGRES_PASSWORD=change_me
POSTGRES_DB=educonnect
POSTGRES_PORT=5433
DATABASE_URL=postgresql://educonnect:change_me@localhost:5433/educonnect?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT (generate long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Cookie SameSite: lax (default, same site), or none when frontend and API are on different domains
COOKIE_SAME_SITE=lax

# Admin account created by `npm run db:seed` (change the password!)
ADMIN_EMAIL=admin@educonnect.local
ADMIN_PASSWORD=ChangeMe123!

# Private verification documents (relative to backend/)
UPLOAD_DIR=uploads/.private

# AI assistant (optional). Without a key the assistant answers with a built-in lesson search.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
